# Bomnado Environment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# REQUIRED - Generate with: python ./generate_secret_key.py -o .env
# =============================================================================
DJANGO_SECRET_KEY=your-secret-key-here

# =============================================================================
# EVALUATION DEPLOYMENT (docker-compose.eval.yml)
# =============================================================================
# For local testing, no additional variables needed beyond DJANGO_SECRET_KEY

# =============================================================================
# PRODUCTION DEPLOYMENT (docker-compose.yml)
# =============================================================================

# Your domain name for SSL certificates
BOMNADO_DOMAIN=yourdomain.com

# Allowed hosts (comma-separated, no spaces)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CSRF trusted origins for HTTPS
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database credentials (required for production)
POSTGRES_USER=bomnado_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=bomnado
POSTGRES_HOST=db

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Email configuration
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Monitoring with Sentry
# SENTRY_DSN=https://your-sentry-dsn-here
# SENTRY_ENVIRONMENT=production

# Database backups to Dropbox
# USE_DROPBOX_BACKUPS=True
# DROPBOX_APP_KEY=your-app-key
# DROPBOX_APP_SECRET=your-app-secret
# DROPBOX_OAUTH2_TOKEN=your-oauth-token
# DROPBOX_OAUTH2_REFRESH_TOKEN=your-refresh-token
# DROPBOX_ROOT_PATH=/bomnado-backups

# Advanced settings (usually don't need to change)
# POSTGRES_PORT=5432
# REDIS_LOCATION=redis://redis:6379
# DJANGO_SETTINGS_MODULE=bomnado.settings.production